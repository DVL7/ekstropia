---
// src/layouts/UnderConstructionLayout.astro

import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ConstructionGraphic from '../components/LoadingGraphic.astro';

interface Props {
  title?: string;
  heading?: string;
  description?: string;
  github?: string;
  ogImage?: string;
}

const {
  title = "Strona w budowie",
  heading = "Strona w budowie",
  description = "Ekstropia to interaktywny atlas wiedzy pokazujący, jak działają systemy i technologie tworzące współczesny świat. ",
  github = "Aby śledzić postęp prac zapraszamy na GitHub",
  ogImage = '/og-image.png'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Ekstropia',
  url: Astro.site,
  description,
  inLanguage: 'pl',
};

---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ekstropia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="pl_PL" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

</head>

<body>
  <SiteHeader />

  <main class="uc-main">
    <div class="uc-content">
      <ConstructionGraphic size={220} />
      <h1>{heading}</h1>
      <p>{description}</p>
      <p>{github}</p>
      <a href="https://github.com/DVL7/ekstropia" class="repo-link" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
        </svg>
  <span>Zobacz na GitHubie</span>
</a>
      <slot />
    </div>
  </main>

  <SiteFooter />
</body>
</html>

<style>
  html, body {
    margin: 0;
    height: 100%;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .uc-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .uc-content {
    text-align: center;
    max-width: 600px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .repo-link {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  color: inherit;
  text-decoration: none;
}

.repo-link:hover {
  text-decoration: underline;
}
</style>